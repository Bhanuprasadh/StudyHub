# ════════════════════════════════════════════════════════════════════════════════
# STUDYHUB BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables as required
# ════════════════════════════════════════════════════════════════════════════════

# ── Database Connection ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bhanuprasadh@localhost:5432/studyhub_db

# ── Security & JWT Authentication ──────────────────────────────────────────────
SECRET_KEY=studyhub_super_secret_jwt_key_for_mtech_project_2026_dev
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# ── Cross-Origin Resource Sharing (CORS) ───────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Razorpay Payment Gateway ───────────────────────────────────────────────────
# Instructions:
# 1. Sign up / log in to https://dashboard.razorpay.com/
# 2. Switch top-right toggle to "Test Mode"
# 3. Go to Account & Settings > API Keys > Generate Key
# 4. Paste your Key ID (starts with rzp_test_) and Key Secret below:
RAZORPAY_KEY_ID=rzp_test_studyhub_demo
RAZORPAY_KEY_SECRET=studyhub_secret_demo_key
RAZORPAY_ENABLED=True

# ── Email & SMTP Notifications (Optional) ──────────────────────────────────────
# Enable when deploying with an active Gmail App Password or SendGrid API:
EMAILS_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@studyhub.edu
SMTP_FROM_NAME="StudyHub Academic Platform"
FRONTEND_URL=http://localhost:5173
