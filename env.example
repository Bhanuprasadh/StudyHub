# ──────────────────────────────────────────────────────────────────────────────
# StudyHub Environment Variables
# Copy this file to .env and fill in every value before running.
# NEVER commit your .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/studyhub_db

# ── JWT Security ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_VALUE_openssl_rand_hex_32
ALGORITHM=HS256

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Environment ───────────────────────────────────────────────────────────────
# Options: development | testing | production
ENVIRONMENT=development

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=60/minute

# ── Account Lockout ───────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
