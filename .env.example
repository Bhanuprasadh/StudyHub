# ==============================================================================
# StudyHub Production / Development Environment Variables (.env)
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/studyhub_db

# Security & JWT Authentication
SECRET_KEY=generate_a_random_32_character_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=production

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://your-domain.com,http://localhost:5173

# Frontend URL (Used for Password Reset & Email Links)
FRONTEND_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration
# Obtain your API keys from Razorpay Dashboard: https://dashboard.razorpay.com/#/app/keys
# (Sandbox/Test mode works out of the box with any rzp_test_* prefix)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_ENABLED=True

# ------------------------------------------------------------------------------
# SMTP Email Notifications (Async Background Delivery)
# When EMAILS_ENABLED=False, emails are safely logged to the console/stdout.
# When EMAILS_ENABLED=True, emails are dispatched via TLS using credentials below.
# ------------------------------------------------------------------------------
EMAILS_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=notifications@your-domain.com
SMTP_FROM_NAME="StudyHub Learning Platform"

# ------------------------------------------------------------------------------
# Frontend Environment Configuration (set in frontend/.env if needed)
# VITE_API_BASE_URL=https://your-api-domain.com/api/v1
# ------------------------------------------------------------------------------
